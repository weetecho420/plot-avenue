# Supabase — the shared Sprout project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://dmfhvxrxkilszdrbghqh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayMongo (GCash / card / QR Ph)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Optional: fixed PHP-per-USD rate instead of the live rate
PHP_PER_USD=

# Stripe (Visa / Mastercard / Apple Pay / Google Pay), charged in USD,
# paid out to your NZ bank. Button stays hidden until NEXT_PUBLIC_STRIPE_ENABLED=1.
# Test keys start with sk_test_, live keys with sk_live_.
NEXT_PUBLIC_STRIPE_ENABLED=
STRIPE_SECRET_KEY=
# From Developers → Webhooks → your endpoint (/api/stripe/webhook), starts with whsec_
STRIPE_WEBHOOK_SECRET=

# NOWPayments (BTC, ETH, SOL, USDT, USDC)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# PayPal (button stays hidden until these are set)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Phantom / Solana (button stays hidden until NEXT_PUBLIC_SOLANA_CLUSTER is set)
# devnet for testing, mainnet-beta for real money
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Your main Phantom address: buyers' SOL goes here
SOLANA_TREASURY_ADDRESS=
# Private key of a SEPARATE minting wallet (pays ~0.004 SOL per NFT)
SOLANA_MINT_SECRET_KEY=
# Optional, from scripts/create-collection.mjs
SOLANA_COLLECTION_ADDRESS=
# Optional, e.g. a Helius URL; defaults to the public RPC
SOLANA_RPC_URL=
# Optional fixed SOL price (testing only)
SOL_USD=
